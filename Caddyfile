www.roamwise.live {
    redir https://roamwise.live{uri} permanent
}
roamwise.live {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -X-Powered-By
    }

    @seo path /robots.txt
    handle @seo {
        reverse_proxy frontend:4000 {
            header_down Cache-Control "public, max-age=3600"
        }
    }

    @sitemap path /sitemap.xml
    handle @sitemap {
        reverse_proxy {$BACKEND_UPSTREAM} {
            header_down Cache-Control "public, max-age=3600"
        }
    }

    # IndexNow ownership key for Bing/Yandex (public by design; used by .github/workflows/indexnow.yml)
    handle /a97fdb5e702b9752db92b42bd24c88df.txt {
        respond "a97fdb5e702b9752db92b42bd24c88df" 200
    }

    # retired guide slugs that Google still crawls (404 in Search Console)
    redir /guides/jaipur-india-4-days /guides/jaipur-india-3-days permanent
    redir /guides/rishikesh-india-4-days /guides/rishikesh-india-2-days permanent

    handle /api/* {
        # keep API/photo-proxy URLs out of Google's index and crawl budget
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    handle {
        reverse_proxy frontend:4000
    }
}